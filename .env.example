# Environment Variables Configuration Example
# Copy this file to .env and fill in your actual values

# Model Configuration
MODEL_CHECKPOINT=models/trained_landcover_unet_efficientnet-b0_epochs18_patch512_batch16.pth
NUM_CLASSES=5
ENCODER=efficientnet-b0
ENCODER_WEIGHTS=imagenet

# Device Configuration
DEVICE=cuda
# DEVICE=cpu  # Use this for CPU-only inference

# Gemini API Configuration (Required for /report endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional: API Key for server authentication
# SERVER_API_KEY=your_server_api_key_here

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=*
# CORS_ORIGINS=http://localhost:3000,https://example.com

# Logging
LOG_LEVEL=info
